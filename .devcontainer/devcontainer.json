{
  "name": "SupportSphere Browser Workspace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    5173,
    8000
  ],
  "portsAttributes": {
    "5173": {
      "label": "SupportSphere Web App",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "Backend API",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash portfolio-projects/supportsphere-helpdesk/scripts/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}